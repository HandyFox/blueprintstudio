# Copy to .env and adjust.

# Host port the container is published on (bound to 127.0.0.1 only).
BPS_PORT=8070

# Serve under a sub-path instead of a whole (sub)domain, e.g. /blueprints.
# Leave empty when the app has its own domain like plans.example.com.
BLUEPRINT_STUDIO_PREFIX=

# Number of reverse proxies in front of the app (nginx = 1). Used to trust
# X-Forwarded-Proto/For/Host/Prefix so secure cookies and links are right.
BLUEPRINT_STUDIO_PROXY_HOPS=1

# The first administrator, created only when no accounts.json exists yet.
# Sign in with these, then change the password from the user menu.
BLUEPRINT_STUDIO_ADMIN_USER=admin
BLUEPRINT_STUDIO_ADMIN_PASSWORD=1234

# Gunicorn tuning (optional)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
